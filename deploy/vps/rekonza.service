# Rekonza, kept running by systemd (deploy/vps/setup.sh fills in the @…@).
# The app reads its settings from .env.production.local in its folder, and its
# own worker does the background work (reminders, retries, scheduled reports).
[Unit]
Description=Rekonza accounting
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=NODE_ENV=production
# Which of the two build folders is live (update.sh builds into the other, then switches).
EnvironmentFile=-@APP_DIR@/.build-dir
ExecStart=@APP_DIR@/node_modules/.bin/next start -p @PORT@ -H 127.0.0.1
Restart=always
RestartSec=5
# A graceful stop lets a request in flight finish.
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
