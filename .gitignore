# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# demo build log
build.log

# out-of-band production build dir
/.next-build/

# local screenshots
/scripts/shots/
dev.log
/.next-verify/

# TallyPrime writes this beside wherever it was started
tallyhttp.log

# The packaged connector: 90 MB, built with npm run connector:build
connector/dist/

# Encrypted database backups (npm run db:backup). Never commit them.
backups/

# Attachments on disk (the stand-in for object storage)
/storage/

# The example env file has no values: keep it, so a new machine knows what to set.
!.env.example

# This machine's own Claude Code permissions.
.claude/settings.local.json
